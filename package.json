{
	"name": "behringer-wing",
	"version": "2.3.1",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"engines": {
		"node": "^22.20 || ^26.5",
		"yarn": "^4"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-behringer-wing.git"
	},
	"dependencies": {
		"@companion-module/base": "^2.1",
		"debounce-fn": "^6.0.0",
		"osc": "^2.4.5",
		"p-queue": "^8.0.1",
		"type-fest": "^4.31.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0",
		"@types/node": "^22.10.2",
		"eslint": "^10.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.11",
		"prettier": "^3.8.1",
		"rimraf": "^6.0.1",
		"typescript": "~5.5.4",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.5"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.5.3+sha256.dddc0b96ad2dca8d56a5302b56bf3cbf8210654474a6bf88877da61e866f3d46"
}
